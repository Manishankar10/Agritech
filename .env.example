# Uzhavan Desk - Environment Configuration & Database Isolation
# ==============================================================

# APP_ENV: Set to 'development' (local) or 'production' (Render/cloud)
APP_ENV=development

# Session security
SECRET_KEY=uzhavan-local-secret-key-2026

# --------------------------------------------------------------
# LOCAL DEVELOPMENT (Separate from production)
# --------------------------------------------------------------
# By default, local development uses high-speed isolated JSON files in local_data/.
# If you want to use MongoDB locally, set DEV_MONGO_URI:
# DEV_MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# DEV_MONGO_DB_NAME=uzhavan_dev_db

# --------------------------------------------------------------
# PRODUCTION (Render.com Environment Variables)
# --------------------------------------------------------------
# On Render, set:
# APP_ENV=production
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB_NAME=uzhavan_prod_db
